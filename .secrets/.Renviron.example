# =============================================================================
# Plantilla de variables del proyecto
# =============================================================================
# Este archivo SÍ se sube a git: tiene los nombres de las variables, qué es cada
# una y un ejemplo inventado, nunca un valor real.
#
# Para una máquina nueva:
#   1. Copiar este archivo como .secrets/.Renviron (con el PUNTO adelante: sin
#      el punto R no lo lee y el .gitignore no lo tapa).
#   2. Completar los valores a la derecha del =. Las variables opcionales que el
#      proyecto no usa se dejan vacías o se borran.
#   3. Listo: R no lo lee solo porque no está en la raíz; lo carga
#      src/00_setup/auth.R en cada corrida, así que no hace falta reiniciar R
#      después de editarlo.
#
# Cuatro cosas que muerden:
#   - Una variable por línea, NOMBRE=valor, sin comillas ni espacios alrededor
#     del =. Un comentario escrito DESPUÉS del valor pasa a ser parte del valor
#     (y la API responde 404 porque no encuentra ese id). Los comentarios van
#     siempre en su propia línea.
#   - Todas las variables van en este archivo. Un .Renviron en la raíz o en la
#     carpeta personal se mezcla con este, y si repite un nombre gana este.
#   - Cada Sheet y carpeta de Drive tiene que estar compartida con el correo de
#     la cuenta de servicio (auth.R lo imprime al autenticarse). Si no, la API
#     responde 403 y el error no dice que es un permiso.
#   - En GitHub Actions las mismas variables llegan como secrets del
#     repositorio, con el MISMO nombre, así el código es uno solo. La única
#     diferencia es GOOGLE_SERVICE_ACCOUNT_KEY (ver más abajo).
#
# Los scripts leen cada variable con env_requerido('NOMBRE'), que corta con el
# nombre de la que falta y nunca imprime su valor. Las opcionales se leen con
# env_opcional('NOMBRE') y el pipeline sigue sin ellas.


# Proyecto --------------------------------------------------------------------

# zona horaria del proyecto: fecha los archivos y la hora de actualización del
# dashboard. Es la misma TZ que usan los workflows
# ej.: TZ=America/Lima
TZ=


# Cuenta de servicio de Google ------------------------------------------------

# ruta a la clave JSON de la cuenta de servicio, dentro de .secrets/. En GitHub
# Actions el secret GOOGLE_SERVICE_ACCOUNT_JSON trae el CONTENIDO del JSON: el
# workflow lo escribe en esta ruta al empezar y lo borra al terminar
# ej.: GOOGLE_SERVICE_ACCOUNT_KEY=.secrets/cuenta_servicio.json
GOOGLE_SERVICE_ACCOUNT_KEY=.secrets/cuenta_servicio.json


# Fuente 1: la encuesta de SurveyCTO (01_import_scto) -------------------------
# El formid NO va aquí: cambia por ronda y vive en sources/rondas.csv

# subdominio del servidor de SurveyCTO (lo que va antes de .surveycto.com)
# ej.: SURVEYCTO_SERVER=miorganizacion
SURVEYCTO_SERVER=

# usuario con permiso de API y su contraseña
# ej.: SURVEYCTO_USERNAME=api.pipeline@miorganizacion.org
SURVEYCTO_USERNAME=
SURVEYCTO_PASSWORD=

# (opcional) Sheet con la copia del dataset de casos que mantiene SurveyCTO,
# para saber si el caso de cada llamada existe (02_audit, dimensión 10)
# ej.: GSHEET_ID_CASOS=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789abcde
GSHEET_ID_CASOS=


# Fuente 2: el registro (01_import_registro) ----------------------------------
# Se completa SOLO el bloque que corresponde a cómo llega el registro

# si llega en un Google Sheet
# ej.: GSHEET_ID_REGISTRO=1ZyXwVuTsRqPoNmLkJiHgFeDcBa9876543210zyxwv
GSHEET_ID_REGISTRO=

# si llega por una API
# ej.: REGISTRO_API_URL=https://api.ejemplo.org/v1/registros
# ej.: REGISTRO_API_KEY=sk_test_0000000000000000
REGISTRO_API_URL=
REGISTRO_API_KEY=

# si llega de una base de datos (PostgreSQL), con un usuario de SOLO LECTURA.
# DB_PORT es opcional: vacío = 5432
# ej.: DB_HOST=db.ejemplo.org
# ej.: DB_NAME=registro
# ej.: DB_USER=lectura_pipeline
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=


# Decisiones humanas (01_import_validacion) -----------------------------------

# (opcional) Sheet donde las supervisoras validan las encuestas con alerta y
# anotan correcciones. 09_publish_sheets agrega ahí las encuestas nuevas con
# alerta y 01_import_validacion trae las decisiones en la corrida siguiente.
# Si está vacía, el pipeline corre sin validación
# ej.: GSHEET_ID_VALIDACION=1QwErTyUiOpAsDfGhJkLzXcVbNm0123456789qwert
GSHEET_ID_VALIDACION=


# Enriquecimiento (04_enrich) -------------------------------------------------

# (opcional) clave de la API de IA o de geocodificación
# ej.: IA_API_KEY=sk-test-0000000000000000000000000000
IA_API_KEY=


# Destinos de 09_publish: Sheets ----------------------------------------------

# Sheet que lee el dashboard de monitoreo en Looker Studio (flujo por hora)
# ej.: GSHEET_ID_MONITOREO=1MnBvCxZaSdFgHjKlPoIuYtReWq0123456789mnbvc
GSHEET_ID_MONITOREO=

# (opcional) Sheet del dashboard de resultados (flujo completo)
# ej.: GSHEET_ID_DASHBOARD=1PoIuYtReWqAsDfGhJkLmNbVcXz0123456789poiuy
GSHEET_ID_DASHBOARD=


# Destinos de 09_publish: Drive -----------------------------------------------
# Una carpeta por etapa de data/, para el respaldo diario (09_publish_drive).
# Las etapas que el proyecto no usa se dejan vacías

# ej.: GDRIVE_ID_RAW=1aBcDeFgHiJkLmNoPqRsTuVwXyZ012345
GDRIVE_ID_RAW=
GDRIVE_ID_AUDIT=
GDRIVE_ID_CLEAN=
GDRIVE_ID_ENRICH=
GDRIVE_ID_INTEGRATE=
GDRIVE_ID_FINAL=

# (opcional) carpeta donde se suben las entregas al cliente (08_products_entrega)
# ej.: GDRIVE_ID_ENTREGAS=1zYxWvUtSrQpOnMlKjIhGfEdCbA987654
GDRIVE_ID_ENTREGAS=


# Destinos de 09_publish: SFTP del cliente ------------------------------------

# (opcional) servidor y credencial del SFTP. SFTP_USERPWD es usuario:contraseña,
# o sea un SECRETO
# ej.: SFTP_HOST=sftp.cliente.com
# ej.: SFTP_USERPWD=usuario:contrasena
SFTP_HOST=
SFTP_USERPWD=


# Rutas propias de la máquina (opcionales) ------------------------------------
# Solo si la detección automática falla. Son de cada máquina: no van en GitHub

# ej.: CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
CHROME_PATH=

# ej.: PYTHON_PATH=C:/Users/usuario/AppData/Local/Programs/Python/Python312/python.exe
PYTHON_PATH=
